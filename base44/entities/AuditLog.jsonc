{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "application_id": {
      "type": "string"
    },
    "integration_mode": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "status_before": {
      "type": "string"
    },
    "status_after": {
      "type": "string"
    },
    "source": {
      "type": "string"
    }
  },
  "required": [
    "action"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}