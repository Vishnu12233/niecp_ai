{
  "name": "ProjectDocument",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "requirement_key": {
      "type": "string"
    },
    "document_name": {
      "type": "string"
    },
    "approval_key": {
      "type": "string"
    },
    "approval_name": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "issue_date": {
      "type": "string"
    },
    "expiry_date": {
      "type": "string"
    },
    "no_expiry": {
      "type": "boolean"
    },
    "authority": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "ai_classification": {
      "type": "object"
    },
    "priority": {
      "type": "string"
    },
    "mandatory": {
      "type": "boolean"
    }
  },
  "required": [
    "profile_id",
    "requirement_key"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}